.wrap {
  padding-bottom: 48rpx;
}

.profile .child-name {
  font-size: 40rpx;
  font-weight: 700;
  margin: 8rpx 0 6rpx;
}

.profile .block {
  margin-top: 20rpx;
}

.profile .sub {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--soft);
}

.profile .note {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.expand-link {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--blush-deep);
  font-weight: 600;
}

.chip.static {
  pointer-events: none;
}

.person-chip,
.cat-chip {
  cursor: pointer;
}

.summary .headline {
  font-size: 36rpx;
  font-weight: 700;
  margin: 10rpx 0 8rpx;
}

.summary .stats {
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.summary .para {
  font-size: 28rpx;
  line-height: 1.55;
  margin-top: 14rpx;
  color: var(--ink);
}

.clear {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.entry .q {
  font-size: 30rpx;
  font-weight: 600;
  margin: 10rpx 0 16rpx;
  line-height: 1.45;
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.layer {
  font-size: 22rpx;
  color: var(--blush-deep);
  font-weight: 600;
  letter-spacing: 0.08em;
}

.layer-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.ans {
  background: var(--sand);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.row-line {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.4;
}

.tag {
  display: inline-block;
  min-width: 40rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--blush-deep);
}

.tag.you {
  color: #6a8fa3;
}

.match {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--soft);
}

.match.hit {
  color: var(--blush-deep);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--sand);
  font-size: 26rpx;
}

.chip.on {
  background: rgba(233, 183, 178, 0.45);
  box-shadow: inset 0 0 0 2rpx var(--blush);
  font-weight: 600;
}
