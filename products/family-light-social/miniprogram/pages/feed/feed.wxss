.wrap {
  padding-bottom: 40rpx;
}

.day-quick {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.day-chip {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: var(--sand);
}

.day-chip.on {
  background: rgba(233, 183, 178, 0.5);
  box-shadow: inset 0 0 0 2rpx var(--blush);
}

.day-chip-main {
  display: block;
  font-weight: 700;
  font-size: 28rpx;
}

.day-chip-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--soft);
}

.date-pick {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--sand);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}

.date-main {
  font-weight: 700;
  font-size: 30rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.more-days {
  margin-top: 12rpx;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--sand);
  font-size: 24rpx;
}

.chip.on {
  background: rgba(233, 183, 178, 0.45);
  box-shadow: inset 0 0 0 2rpx var(--blush);
  font-weight: 600;
}

.area {
  width: 100%;
  min-height: 140rpx;
  margin-top: 16rpx;
  background: var(--sand);
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.back-today {
  margin-top: 16rpx;
  background: var(--sand) !important;
}

.ghost {
  background: var(--sand) !important;
}

.pick-img {
  font-weight: 600 !important;
  box-shadow: inset 0 0 0 2rpx var(--blush);
}

.nudge-card {
  background: linear-gradient(135deg, rgba(213,225,232,.55), rgba(233,183,178,.22));
}

.nudge-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.nudge-row:last-child {
  border-bottom: none;
}

.nudge-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
}

.nudge-ok {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--blush-deep);
  font-weight: 600;
  padding-top: 4rpx;
}

.remind-btn {
  margin-top: 16rpx !important;
}

.linkish {
  margin-top: 8rpx;
  color: var(--blush-deep);
}

.primary {
  background: rgba(233, 183, 178, 0.7) !important;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.clear {
  display: block;
  margin-top: 8rpx;
  color: var(--soft);
  font-size: 24rpx;
}

.meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.name {
  font-weight: 600;
}

.photo {
  width: 100%;
  border-radius: 20rpx;
  margin-top: 16rpx;
}

.reacts {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}

.emoji {
  font-size: 36rpx;
  padding: 4rpx 8rpx;
  border-radius: 12rpx;
  line-height: 1.2;
}

.emoji.on {
  background: rgba(233, 183, 178, 0.45);
}

.react-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.react-pill {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--sand);
}

.react-pill.on {
  background: rgba(233, 183, 178, 0.45);
  font-weight: 600;
}

.comments {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: rgba(240, 231, 220, 0.55);
  border-radius: 16rpx;
}

.comment {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.4;
}

.comment + .comment {
  border-top: 1rpx solid var(--line);
}

.c-name {
  font-weight: 700;
  color: var(--blush-deep);
  flex-shrink: 0;
}

.c-text {
  flex: 1;
  min-width: 40%;
}

.c-del {
  font-size: 22rpx;
  color: var(--soft);
  flex-shrink: 0;
}

.comment-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 16rpx;
}

.comment-input {
  flex: 1;
  background: var(--sand);
  border-radius: 999rpx;
  padding: 14rpx 22rpx;
  font-size: 26rpx;
}

.comment-btn {
  flex-shrink: 0;
  margin: 0 !important;
}

.del {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--blush-deep);
  text-align: right;
}
