page {
  --ink: #2f2a28;
  --soft: #8a817c;
  --blush: #e9b7b2;
  --blush-deep: #d4928c;
  --sand: #f0e7dc;
  --paper: #fbf9f7;
  --sky: #d5e1e8;
  --line: rgba(47, 42, 40, 0.08);
  background: #efeae4;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(47, 42, 40, 0.05);
}

.label {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: var(--blush-deep);
  font-weight: 600;
  text-transform: uppercase;
}

.hint {
  color: var(--soft);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--sand);
  color: var(--ink);
  font-size: 26rpx;
}

.chip.on {
  background: rgba(233, 183, 178, 0.45);
  box-shadow: inset 0 0 0 2rpx var(--blush);
  font-weight: 600;
}

.chip.green.on {
  background: rgba(124, 184, 154, 0.38);
  box-shadow: inset 0 0 0 2rpx #7cb89a;
  color: #2a4538;
}

.back-bar {
  margin: 16rpx 24rpx 0;
  padding: 12rpx 8rpx;
  color: var(--blush-deep);
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary {
  margin: 24rpx;
  background: linear-gradient(135deg, #f3d4cf, #e9b7b2 60%, #d8c4df);
  color: var(--ink);
  border-radius: 24rpx;
  font-weight: 600;
}

.btn-ghost {
  margin: 0 24rpx 24rpx;
  background: var(--sand);
  color: var(--ink);
  border-radius: 24rpx;
}

.input {
  background: var(--sand);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-top: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.muted {
  color: var(--soft);
}
